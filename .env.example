# Copy to .env.local for development, and set the same variables on your host.

# Public production origin for canonical URLs, Open Graph, sitemap and robots.txt.
# Example: https://www.casolution4u.in  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form delivery (Resend, https://resend.com). All three are required.
# Until they are set, /api/contact answers 503 and the form tells visitors
# plainly that it was not sent, then offers WhatsApp or email with their
# details prefilled. It never shows a false success.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Inbox that receives enquiries.
CONTACT_TO_EMAIL=casolution4u@gmail.com
# Sender on a domain verified in Resend, e.g. "CA SOLUTION4U Website <website@your-domain>".
CONTACT_FROM_EMAIL=
